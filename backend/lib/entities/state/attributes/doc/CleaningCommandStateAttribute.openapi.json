{
  "components": {
    "schemas": {
      "CleaningCommandStateAttribute": {
        "allOf": [
          {"$ref": "#/components/schemas/StateAttribute"},
          {
            "type": "object",
            "required": ["id", "command", "state", "source", "targetRevision", "createdAt", "updatedAt", "error", "revision"],
            "properties": {
              "id": {"type": "string", "format": "uuid"},
              "command": {"type": "string", "enum": ["home", "start_all", "start_segments"]},
              "state": {"type": "string", "enum": ["pending", "accepted", "verified", "failed", "uncertain"]},
              "source": {"type": "string"},
              "targetRevision": {"type": "integer", "minimum": 0, "nullable": true},
              "createdAt": {"type": "string", "format": "date-time"},
              "updatedAt": {"type": "string", "format": "date-time"},
              "error": {"type": "string", "nullable": true},
              "revision": {"type": "integer", "minimum": 0}
            }
          }
        ]
      }
    }
  }
}
